{
  "name": "crypto-avatars",
  "version": "2.0.0",
  "description": "Crypto avatars service on Cloudflare Workers with blockchain integration",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "tail:staging": "wrangler tail --env staging",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/**/*.ts",
    "kv:create": "wrangler kv:namespace create AVATAR_CACHE && wrangler kv:namespace create SESSION_CACHE && wrangler kv:namespace create NONCE_CACHE && wrangler kv:namespace create RATE_LIMIT_CACHE"
  },
  "keywords": [
    "crypto",
    "avatars",
    "blockchain",
    "nft",
    "cloudflare-workers",
    "typescript",
    "web3",
    "ens",
    "lens",
    "siwe"
  ],
  "author": "Chris Korhonen",
  "license": "ISC",
  "dependencies": {
    "siwe": "^2.1.4",
    "ethers": "^6.10.0",
    "@lens-protocol/client": "^2.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240129.0",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wrangler": "^3.25.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}