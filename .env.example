# Cloudflare Workers Configuration
# Copy this file to .dev.vars for local development
# For production, use: wrangler secret put <SECRET_NAME>

# Required API Keys
ALCHEMY_API_KEY=your-alchemy-api-key-here
OPENSEA_API_KEY=your-opensea-api-key-here
LENS_API_ENDPOINT=https://api-v2.lens.dev

# Optional API Keys
FARCASTER_API_KEY=your-farcaster-api-key-here

# Environment Configuration (set in wrangler.toml for actual deployments)
# ENVIRONMENT=development
# DEFAULT_AVATAR_BASE_URL=https://api.dicebear.com/7.x/identicon/svg
# MAX_AVATAR_SIZE=2048